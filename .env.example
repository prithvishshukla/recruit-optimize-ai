# TalentForge AI - SaaS Environment Configurations

# 1. Supabase Credentials
# Base Project URL (e.g., https://your-project-id.supabase.co) - DO NOT append /rest/v1
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Project Anon API Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# 2. Cloudinary Uploads
# Cloud name from your Cloudinary console settings
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
# Unsigned upload preset created in Cloudinary console (Settings -> Upload -> Upload presets)
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# 3. Google Gemini AI API
# Generate an API key from Google AI Studio (https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your-google-gemini-api-key

# 4. Razorpay Payments
# Razorpay Key ID generated from Razorpay dashboard API Keys settings (Key Secret is handled on server/webhooks)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
